# GovTech Models API, using x-api-key authentication.
# Include /v1 in the SDK base URL; do not append /chat/completions.
AI_BASE_URL=https://api.ai.tech.gov.sg/platform/models/v1
AI_API_KEY=
AI_MODEL=azure.claude-fable-5
AI_TIMEOUT_SECONDS=60

MAX_FILES=10
MAX_FILE_MB=20
MAX_TABLES=30
MAX_ROWS_PER_TABLE=100000
MAX_COLUMNS=100
MAX_RESULT_ROWS=200
QUERY_TIMEOUT_SECONDS=15
DUCKDB_MEMORY_MB=512
SAMPLE_ROWS=3
HISTORY_MESSAGES=10
MAX_QUESTION_CHARS=4000
MAX_CONTEXT_CHARS=60000
CSV_ENCODING=utf-8-sig
MAX_PDF_FILES=5
MAX_PDF_PAGES=100
MAX_PDF_CHARS=500000
PDF_CONTEXT_CHARS=24000
PLAN_MAX_OUTPUT_TOKENS=8000
PLAN_RETRY_MAX_OUTPUT_TOKENS=16000
ANSWER_MAX_OUTPUT_TOKENS=4000
